<%- layout("./layout/boilerplate") %>

<div class="card mx-auto" style="max-width:900px;">
  <img src="<%= camp.image %>" style="height: 500px; object-fit: cover;" class="card-img-top" alt="<%= camp.title %>">
  <div class="card-body">
    <h5 class="card-title"><%= camp.title %></h5>
    <p class="card-text"><%= camp.description %></p>
    <div class="container">
        <div class="row">
            <div class="col-6 p-0">
                <p class="card-text">
                    <small class="text-body-secondary">
                        <%= camp.location %>
                    </small>
                </p>
            </div>
            <div class="col-6 p-0">
                <p class="card-text" style="text-align: right;">Price: <%= camp.price%>$</p>
            </div>
        </div>
    </div>
  </div>
  <div class="card-body d-flex">
        <a href="/campgrounds/<%= camp.id %>/edit" class="btn btn-info me-2">Update</a>
        <form action="/campgrounds/<%= camp._id %>?_method=DELETE" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
  </div>
</div>